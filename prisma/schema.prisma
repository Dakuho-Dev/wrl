// OwlFlow – Order management & fulfillment automation platform
// Database schema. PostgreSQL — works with Neon, Vercel Postgres, Supabase or a
// local container (see docker-compose.yml).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- Users / auth

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  company      String?
  phone        String?
  country      String?
  avatarUrl    String?
  role         String    @default("USER") // USER | ADMIN
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING
  planId       String?
  emailVerified Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan         Plan?         @relation(fields: [planId], references: [id])
  shops        Shop[]
  automations  Automation[]
  apiKeys      ApiKey[]
  tickets      Ticket[]
  ticketReplies TicketReply[]
  activities   ActivityLog[]
  webhooks     WebhookEndpoint[]
  notifications Notification[]

  @@index([role])
  @@index([status])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  priceMonthly Float   @default(0)
  priceYearly  Float   @default(0)
  orderLimit  Int      @default(100)
  shopLimit   Int      @default(1)
  features    String   @default("[]") // JSON array of strings
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// ---------------------------------------------------------------- Sales channels

model Shop {
  id             String    @id @default(cuid())
  userId         String
  platform       String // ETSY | SHOPIFY | AMAZON | TIKTOK
  externalId     String? // e.g. Etsy shop_id
  name           String
  url            String?
  currency       String    @default("USD")
  status         String    @default("CONNECTED") // CONNECTED | DISCONNECTED | ERROR | SYNCING
  isDemo         Boolean   @default(false)
  // OAuth material (encrypted at rest in production)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String?
  externalUserId String?
  lastSyncAt     DateTime?
  lastSyncError  String?
  autoSync       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]
  products Product[]
  syncJobs SyncJob[]

  @@index([userId])
  @@index([platform])
  @@index([status])
}

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  codeVerifier String
  userId       String
  platform     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------- Catalog

model Product {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String?
  title       String
  sku         String?
  price       Float    @default(0)
  currency    String   @default("USD")
  quantity    Int      @default(0)
  imageUrl    String?
  state       String   @default("active") // active | draft | inactive | sold_out
  tags        String   @default("[]")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([shopId])
  @@index([state])
}

// ---------------------------------------------------------------- Orders

model Order {
  id            String    @id @default(cuid())
  shopId        String
  externalId    String? // Etsy receipt_id
  orderNumber   String
  buyerName     String
  buyerEmail    String?
  buyerMessage  String?
  status        String    @default("NEW") // NEW | PROCESSING | ON_HOLD | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus String    @default("PAID") // PAID | PENDING | REFUNDED | FAILED
  fulfillment   String    @default("UNFULFILLED") // UNFULFILLED | PARTIAL | FULFILLED
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  subtotal      Float     @default(0)
  shippingCost  Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  currency      String    @default("USD")
  shipName      String?
  shipLine1     String?
  shipLine2     String?
  shipCity      String?
  shipState     String?
  shipZip       String?
  shipCountry   String?
  notes         String?
  tags          String    @default("[]")
  placedAt      DateTime  @default(now())
  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  shipments Shipment[]
  events    OrderEvent[]

  @@index([shopId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  title           String
  sku             String?
  variation       String?
  personalization String?
  quantity        Int     @default(1)
  price           Float   @default(0)
  imageUrl        String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // CREATED | STATUS_CHANGED | NOTE | SHIPPED | AUTOMATION | SYNC
  message   String
  actor     String   @default("system")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  carrier        String
  service        String?
  trackingNumber String
  trackingUrl    String?
  status         String    @default("LABEL_CREATED") // LABEL_CREATED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION
  cost           Float     @default(0)
  weightGrams    Int?
  labelUrl       String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  pushedToShop   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------- Automation

model Automation {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  trigger     String // ORDER_CREATED | ORDER_PAID | ORDER_SHIPPED | SYNC_COMPLETED | SCHEDULE
  conditions  String   @default("[]") // JSON
  actions     String   @default("[]") // JSON
  enabled     Boolean  @default(true)
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  status       String   @default("SUCCESS") // SUCCESS | FAILED | SKIPPED
  message      String?
  orderId      String?
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model SyncJob {
  id         String    @id @default(cuid())
  shopId     String
  type       String // ORDERS | PRODUCTS | TRACKING | FULL
  status     String    @default("QUEUED") // QUEUED | RUNNING | SUCCESS | FAILED
  itemsRead  Int       @default(0)
  itemsSaved Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

// ---------------------------------------------------------------- Platform

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  keyHash    String
  scopes     String    @default("[\"read\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String   @default("[]")
  secret    String
  enabled   Boolean  @default(true)
  failCount Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Ticket {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  name      String
  subject   String
  message   String
  category  String   @default("GENERAL") // GENERAL | BILLING | TECHNICAL | INTEGRATION
  priority  String   @default("NORMAL")
  status    String   @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?         @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([status])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  authorName String
  isStaff   Boolean  @default(false)
  message   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  level     String   @default("INFO") // INFO | WARN | ERROR
  category  String   @default("SYSTEM") // AUTH | SYNC | ORDER | AUTOMATION | ADMIN | SYSTEM
  message   String
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
