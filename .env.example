# ============================================================ Database
# Production: Neon / Vercel Postgres connection string (pooled).
# Local: docker compose up -d  →  the URL below.
DATABASE_URL="postgresql://dkh:dkh@localhost:5433/dkh?schema=public"

# ============================================================ App
# Public URL of this deployment. Used to build the Etsy OAuth redirect URI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="DKH"

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Encrypts marketplace OAuth tokens at rest. Generate the same way.
# If omitted, AUTH_SECRET is used instead.
ENCRYPTION_KEY=""

# ============================================================ Etsy Open API v3
# From https://www.etsy.com/developers/your-apps once your app is approved.
# Leave empty to run in DEMO mode (simulated shop connections).
ETSY_CLIENT_ID=""
ETSY_CLIENT_SECRET=""
# Must match EXACTLY the callback URL registered in your Etsy app:
ETSY_REDIRECT_URI="http://localhost:3000/api/integrations/etsy/callback"
ETSY_SCOPES="email_r shops_r shops_w listings_r listings_w transactions_r transactions_w"

# ============================================================ Demo data
# Credentials created by `npm run db:seed`. Change these before seeding production.
DEMO_SELLER_EMAIL="seller@dkh.io"
DEMO_SELLER_PASSWORD="Password123!"
DEMO_ADMIN_EMAIL="admin@dkh.io"
DEMO_ADMIN_PASSWORD="Admin123!"
# Set to "false" to hide the demo credentials box on the login page.
SHOW_DEMO_CREDENTIALS="true"
