# ============================================================ Database
# Production: Neon / Vercel Postgres connection string (pooled).
# Local: docker compose up -d  →  the URL below.
DATABASE_URL="postgresql://dkh:dkh@localhost:5433/dkh?schema=public"

# ============================================================ App
# Public URL of this deployment. Used to build the Etsy OAuth redirect URI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="DKH"

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Encrypts marketplace OAuth tokens at rest. Generate the same way.
# If omitted, AUTH_SECRET is used instead.
ENCRYPTION_KEY=""

# ============================================================ Etsy Open API v3
# From https://www.etsy.com/developers/your-apps once your app is approved.
# Leave empty to run in DEMO mode (simulated shop connections).
ETSY_CLIENT_ID=""
ETSY_CLIENT_SECRET=""
# Must match EXACTLY the callback URL registered in your Etsy app:
ETSY_REDIRECT_URI="http://localhost:3000/api/integrations/etsy/callback"
ETSY_SCOPES="email_r shops_r shops_w listings_r listings_w transactions_r transactions_w"

# ============================================================ Demo data
# Credentials created by `npm run db:seed`. Change these before seeding production.
DEMO_SELLER_EMAIL="seller@dkh.io"
DEMO_SELLER_PASSWORD="Password123!"
DEMO_ADMIN_EMAIL="admin@dkh.io"
DEMO_ADMIN_PASSWORD="Admin123!"
# Set to "false" to hide the demo credentials box on the login page.
SHOW_DEMO_CREDENTIALS="true"

# ---------- Tracking, lane 1: USPS (about 80% of parcels) ----------
# Etsy's API returns carrier + tracking number but no transit state. For USPS
# the carrier answers for free: register an app at https://developer.usps.com,
# add the "Tracking" API to it, and paste the Consumer Key / Secret here.
USPS_CLIENT_ID=""
USPS_CLIENT_SECRET=""

# ---------- Tracking, lane 2: the local 17track agent (everything else) ----------
# DHL, Yanwen, YunExpress, UniUni, UPS, OnTrac, SPX ... are looked up by an app
# running on an operator's machine, which reads its queue from
# /api/tracking/manual/pending and posts answers to /api/tracking/manual/results.
# This is the shared secret it authenticates with (x-agent-token). Generate one
# with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANUAL_TRACKING_TOKEN=""
# Don't hand the same parcel back to the agent more often than this (default 6).
MANUAL_RECHECK_HOURS="6"

# ---------- Downstream CMS (Dakuho) ----------
# Where the scheduled job pushes finished order rows.
CMS_BASE_URL="https://apiserver.dakuho.com"
# Must match ORDER_SYNC_TOKEN on the CMS server.
CMS_SYNC_TOKEN=""
# Only set this while the CMS endpoint for the production list (/order/sync)
# lives on a different server from the shipment view — e.g. a dev box behind a
# tunnel. Unset, the production-list push follows CMS_BASE_URL like everything
# else. Setting CMS_BASE_URL instead would move BOTH pushes, which is rarely
# what you want.
CMS_ORDERS_BASE_URL=""
# Set to "1" to have the production-list push report what it WOULD send without
# sending anything or marking anything. Use it once to check that "personalised"
# here means the same orders as the tab the team works from.
CMS_ORDERS_DRY_RUN=""

# ---------- Scheduler ----------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron runs.
CRON_SECRET=""

# First sync of a shop only reaches back this many days (default 30).
SYNC_BACKFILL_DAYS="30"
# Only parcels shipped within this many days are looked up at all (default 30).
TRACK_WINDOW_DAYS="30"
